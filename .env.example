# Neon Postgres connection string.
# Create a project at https://neon.tech, then copy the POOLED connection string.
#
#   cp .env.example .env.local   and paste yours below
#
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Kill switch for the /import page's commit action (D-89). Unset or anything
# other than exactly "true" and POST /api/import/master-sheet/commit refuses
# with a 403 before it touches the request — the entire lead layer is deleted
# and reloaded by that route. Auth (currently disabled) would gate this
# route too, but this stays as a second, independent gate: leave it unset
# until you actually mean for a signed-in user to be able to trigger it.
ALLOW_MASTER_SHEET_IMPORT="false"

# Shared bearer token used only for authenticated server-to-server integration.
# Generate a long random value and configure the same value as CRM_INTEGRATION_TOKEN in WalkTrack.
INTEGRATION_API_TOKEN=""

# Live Google Sheet import for Marketing Intelligence (D-94). Optional. Unset,
# a sheet must be shared as "Anyone with the link" and is read through
# Google's export URL. Set to the JSON key of a Google Cloud service account
# with the Google Sheets API enabled (one line, or base64) to read private
# sheets instead: share each sheet with the key's client_email as a Viewer.
GOOGLE_SERVICE_ACCOUNT_KEY=""

# Minutes between automatic sheet checks by the in-process timer. Defaults to
# 5; 0 turns the timer off. Ignored on Vercel, which has no process to run it.
MARKETING_SHEET_SYNC_MINUTES="5"

# Temporary campaign routing (see src/lib/marketing/sheet-routing.ts). Through
# each IST date (inclusive), leads from the matching worksheet tab are assigned
# to one salesperson, and other salespeople's Claim 10 skips them.
# "BLVD Club" tabs -> Roopa S, who claims only those leads.
# "Shubh Convention" tabs -> Abhishek Thapa, who claims those first, then the general pool.
SHUBH_CONVENTION_ROUTING_UNTIL="2026-10-15"
BLVD_CLUB_ROUTING_UNTIL="2026-10-15"

# Bearer token for GET/POST /api/marketing/sheet-sync/cron, the scheduled
# trigger for hosts where the timer cannot be relied on. Unset, that route
# always answers 401.
CRON_SECRET=""
