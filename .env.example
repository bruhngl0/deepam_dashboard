# Neon Postgres connection string.
# Create a project at https://neon.tech, then copy the POOLED connection string.
#
#   cp .env.example .env.local   and paste yours below
#
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Kill switch for the /import page's commit action (D-89). Unset or anything
# other than exactly "true" and POST /api/import/master-sheet/commit refuses
# with a 403 before it touches the request — the entire lead layer is deleted
# and reloaded by that route. Auth (currently disabled) would gate this
# route too, but this stays as a second, independent gate: leave it unset
# until you actually mean for a signed-in user to be able to trigger it.
ALLOW_MASTER_SHEET_IMPORT="false"

# Shared bearer token used only for authenticated server-to-server integration.
# Generate a long random value and configure the same value as CRM_INTEGRATION_TOKEN in WalkTrack.
INTEGRATION_API_TOKEN=""
