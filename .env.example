# Neon Postgres connection string.
# Create a project at https://neon.tech, then copy the POOLED connection string.
#
#   cp .env.example .env.local   and paste yours below
#
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Clerk. Provisioned by `vercel integration add clerk`, which writes both keys
# into the Vercel project; pull them locally with `vercel env pull .env.local`.
#
# The Clerk instance MUST be set to restricted sign-up (Clerk dashboard →
# Configure → Restrictions → Sign-up mode: Restricted). This app ships no
# /sign-up route, but without that setting the Clerk API will still let anyone
# self-register, and every account can read all customer contact details.
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# Without this, Clerk defaults to redirecting a signed-out visitor to its own
# hosted Account Portal (*.accounts.dev) instead of this app's own /sign-in
# page — found by testing against real keys, not documented anywhere in
# Clerk's own quickstart for this version.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# Kill switch for the /import page's commit action (D-89). Unset or anything
# other than exactly "true" and POST /api/import/master-sheet/commit refuses
# with a 403 before it touches the request — the entire lead layer is deleted
# and reloaded by that route. Auth (CLERK_SECRET_KEY above) now gates this
# route too, but this stays as a second, independent gate: leave it unset
# until you actually mean for a signed-in user to be able to trigger it.
ALLOW_MASTER_SHEET_IMPORT="false"
